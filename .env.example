# ------------------------------------------------------------------
# RyujinOS configuration
# Copy this file to ".env" and fill in your values.
# ------------------------------------------------------------------

# Application
APP_NAME="RyujinOS"
APP_ENV=production            # production | local
APP_DEBUG=false               # true to show detailed errors
APP_URL=http://localhost:8000
APP_KEY=                      # random 32+ char string (used for CSRF / signing)
APP_LOCALE=tr
APP_CURRENCY=TL
APP_TIMEZONE=Europe/Istanbul

# Database (your website tables live here).
# Use the SAME database as AuthMe / Velocity Auth so in-game
# registrations automatically become website accounts.
DB_CONNECTION=mysql           # mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ryujinos
DB_USERNAME=root
DB_PASSWORD=
# For sqlite (local testing only):
DB_SQLITE_PATH=storage/ryujinos.sqlite

# --- AuthMe / Velocity Auth integration ---------------------------
# When enabled, the site reads & writes the plugin's player table so a
# player who registers in-game can immediately log in on the website
# (and vice-versa) using the same username + password.
AUTH_INTEGRATION=authme       # native | authme | velocity
AUTHME_TABLE=authme
AUTHME_COL_NAME=username
AUTHME_COL_PASSWORD=password
AUTHME_COL_EMAIL=email
AUTHME_COL_IP=ip
AUTHME_COL_LASTLOGIN=lastlogin
AUTHME_COL_REGDATE=regdate
# AuthMe hash algorithm: SHA256 (default AuthMe) | BCRYPT | ARGON2 | SHA512 | PLAINTEXT
AUTHME_HASH=SHA256

# --- Minecraft server (RCON) --------------------------------------
# Used to deliver purchased products (run commands) and read server status.
MC_SERVER_NAME="play.ryujinos.net"
MC_SERVER_HOST=127.0.0.1
MC_SERVER_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# --- Shopier payment ----------------------------------------------
# Get these from https://www.shopier.com merchant panel (API section).
SHOPIER_API_USER=
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
SHOPIER_TEST_MODE=true        # true = sandbox/mock (no real charge)
# 1 unit of currency == how many credits? (e.g. 1 TL = 1 credit)
CREDIT_RATE=1
