# ------------------------------------------------------------------
# RyujinOS configuration
# Copy this file to ".env" and fill in your values.
# ------------------------------------------------------------------

# Application
APP_NAME="RyujinOS"
APP_ENV=production            # production | local
APP_DEBUG=false               # true to show detailed errors
APP_URL=http://localhost:8000
APP_KEY=                      # random 32+ char string (used for CSRF / signing)
APP_LOCALE=tr
APP_CURRENCY=TL
APP_TIMEZONE=Europe/Istanbul

# Database. The site uses a single unified `Accounts` table that holds both
# in-game (AuthMe-style) and website data, so a player who registers in-game
# automatically has a website account and vice-versa. Point the game auth
# plugin and the site at the SAME database/table.
DB_CONNECTION=mysql           # mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ryujinos
DB_USERNAME=root
DB_PASSWORD=
# For sqlite (local testing only):
DB_SQLITE_PATH=storage/ryujinos.sqlite

# --- Account password hashing -------------------------------------
# Hash format for the shared `password` column in the Accounts table, so the
# same username + password works both in-game and on the website.
# SHA256 (default AuthMe) | BCRYPT | ARGON2 | SHA512 | PLAINTEXT
AUTHME_HASH=SHA256

# --- Minecraft server (RCON) --------------------------------------
# Used to deliver purchased products (run commands) and read server status.
MC_SERVER_NAME="play.ryujinos.net"
MC_SERVER_HOST=127.0.0.1
MC_SERVER_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# --- Shopier payment ----------------------------------------------
# Get these from https://www.shopier.com merchant panel (API section).
SHOPIER_API_USER=
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
SHOPIER_TEST_MODE=true        # true = sandbox/mock (no real charge)
# 1 unit of currency == how many credits? (e.g. 1 TL = 1 credit)
CREDIT_RATE=1
